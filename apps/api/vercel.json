{
  "version": 2,
  "builds": [
    {
      "src": "src/lambda.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["src/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/lambda.ts"
    }
  ],
  "functions": {
    "src/lambda.ts": {
      "maxDuration": 30,
      "memory": 1024
    }
  }
}
